# Safe Card MVP — environment
# Copy to .env.local and fill when the project-owned Supabase is provisioned.
# Without these, the app runs in SYNTHETIC MODE (local JSONL store, no real data).

# Supabase project URL (e.g. https://xxxx.supabase.co)
SUPABASE_URL=

# Service role key: SERVER-SIDE ONLY. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
